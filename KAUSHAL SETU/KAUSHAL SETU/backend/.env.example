# Kaushal Setu backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# How long issued tokens stay valid, in hours.
JWT_EXPIRES_HOURS=72

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Set to 0 to disable Flask debug mode (use 0 in production).
FLASK_DEBUG=1
